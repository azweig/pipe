# pipe — variables de entorno. Copiá a .env y completá lo que uses.
# NADA acá es obligatorio salvo lo que el canal/feature que actives necesite. El .env NUNCA se commitea.
# La identidad del hub (nombre, números, correos) va en data/hub-config.json (ver hub-config.example.json), no acá.

# ── Servidor web ──
PORT=3000
# 0.0.0.0 dentro de un container; 127.0.0.1 detrás de un reverse proxy en el host
HOST=127.0.0.1
# BUILD_VERSION=dev

# ── IA (traé tu propia key — o configurá el motor desde la UI, Configuración → Motor de IA) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# para modelos locales (privacidad total)
OLLAMA_HOST=http://127.0.0.1:11434
# Orden de fallback de proveedores para tareas INTERACTIVAS / no-sensibles (coma-separado). NO afecta a los crons privados
# (graphify/learn/email-sum/enrich): esos son local-only salvo SENSITIVE_ALLOW_CLOUD=1 (ver abajo). Perilla segura de tocar.
# LLM_CHAIN=gemini,openai,anthropic,ollama
# Presupuesto diario de tokens cloud (corta a local al pasarse):
# LLM_DAILY_CLOUD_TOKEN_BUDGET=
# LLM_DAILY_CLOUD_HARDCAP=
# Overrides de modelo (opcional): OPENAI_MODEL, ANTHROPIC_MODEL, GEMINI_MODEL, VISION_MODEL, EMBED_MODEL, STT_MODEL, TTS_MODEL, TTS_VOICE
# Voz local (STT): WHISPER_BIN=/path/to/whisper-cli, WHISPER_MODEL, WHISPER_THREADS

# ── Matrix (bridges de WhatsApp/Telegram/etc. — ver deploy/PROVISIONING.md) ──
MATRIX_HS=http://localhost:8008
MATRIX_USER=admin
MATRIX_PW=
MATRIX_DOMAIN=localhost
# MAUTRIX_WA_DB=/path/to/mautrix-whatsapp.db   # para leer fotos/portales del bridge
# BRIDGES_ENABLED=whatsapp                      # limita /link a los bridges instalados (vacío = todos)

# ── Telegram (cuenta propia, API de Telegram) ──
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# ── Microsoft 365 / Teams / Outlook (Graph) ──
MS_CLIENT_ID=
MS_TENANT_ID=

# ── Google (OAuth: Gmail + Calendar + Drive con "Conectar → Permitir" desde la UI) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Unipile (WhatsApp/LinkedIn vía API gestionada — alternativa al bridge mautrix; ver docs/UNIPILE.md) ──
UNIPILE_API_KEY=
# ej. https://api46.unipile.com:17613
UNIPILE_DSN=
# UNIPILE_NUMBERS=15551234567      # números gestionados por Unipile (coma-separado); el resto va por el bridge
# UNIPILE_POLL_MS=15000            # cada cuánto sondea mensajes nuevos

# ── Integraciones opcionales ──
NOTION_TOKEN=
# búsqueda web (noticias, research de reuniones)
SERPER_API_KEY=

# ── Secretos en reposo (tokens BYOK cifrados) ──
# clave AES-256 (32 bytes). Generala con:  openssl rand -base64 32 . Si falta, se genera ./data/.secret-key. EN DOCKER: SETEALA (el ./.secret-key no persiste entre rebuilds → romperías los tokens BYOK cifrados)
SECRETS_KEY=

# ── Push web (se autogeneran a ./data/vapid.json si faltan) ──
# VAPID_MAILTO=you@example.com

# ── Sync del vault a un server remoto (opcional, script src/vault-sync.mjs) ──
# VAULT_DEST=user@your-server:/opt/pipe/vault/
# VAULT_SSH_KEY=~/.ssh/id_ed25519

# ── PRODUCCIÓN / hardening (ver docs/DEPLOY.md — el checklist de go-live) ──
# BACKUP_RCLONE_REMOTE=r2:pipe-backups   # remote rclone para el backup offsite del CAS (media). SIN esto, RPO=∞ (riesgo #1)
# TRUSTED_HOSTS=hub.tudominio.com        # allowlist de Host (anti DNS-rebinding); poné tu(s) dominio(s) reales detrás de Caddy
# LLM_BLOCK_PRIVATE_HOSTS=1              # bloquea que un Ollama-host apunte a IPs privadas (anti-SSRF). Prod = 1
# DB_BUSY_TIMEOUT_MS=10000              # tolerancia a contención de SQLite bajo carga (el default 2000 dio SQLITE_BUSY en prod)
# DB_CACHE_MB=16                         # cache de SQLite por conexión
# CAS_TRASH_DAYS=30                      # días que la media borrada vive en la papelera antes de purgarse
# SENSITIVE_ALLOW_CLOUD=1                # ESCAPE: permite que los crons sensibles (graphify/learn/…) usen la nube. Default 0 = local-only

# ── Rutas (defaults razonables; override solo si hace falta) ──
# MESSAGES_DB=./data/messages.db

# ── Ko-fi (opcional): "buy me a coffee" + membresías → bandeja/avisos. Webhook: /api/webhook/kofi
# verification_token de Ko-fi (Advanced en la API de tu página)
KOFI_TOKEN=
# a quién avisar en cada suscripción nueva (para armar el server del cliente)
KOFI_ADMIN_EMAIL=
# opcional: ruta al waitlist.jsonl del landing ({email,lang}) → email al cliente en su idioma
KOFI_WAITLIST=

# SMS ingest (opcional) — token para POST /api/ingest/sms desde el forwarder del celu o el reader de Mac (src/sms-imessage.mjs).
# Generá uno: openssl rand -hex 24 . El SMS se vincula por NÚMERO al hilo de WhatsApp del mismo contacto.
SMS_TOKEN=

# Slack (opcional) — app en api.slack.com con scopes *:history + users:read + chat:write. Sin token → inactivo.
SLACK_TOKEN=
# Signal (opcional) — vía signal-cli-rest-api (Docker). Se une por número a WhatsApp/SMS del mismo contacto.
SIGNAL_CLI_URL=
SIGNAL_NUMBER=
# Buzón de grabaciones (opcional) — carpeta donde tirás audios (Plaud/memos) → Whisper → Notas. Default ./data/recordings
RECORDINGS_DIR=
